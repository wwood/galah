# Compile Galah from crates.io; third-party tools come from a conda environment.
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential wget git curl ca-certificates cmake pkg-config libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CONDA_DIR=/opt/conda
RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p $CONDA_DIR && rm /tmp/miniconda.sh

# Third-party tools that must be on PATH. Barrnap, tRNAscan-SE, CheckM2, isiteuk and EukCC are
# deliberately omitted: galah falls back to its bundled pixi manifest for them (needs pixi on PATH).
RUN $CONDA_DIR/bin/conda create -y -n galah_deps --override-channels -c conda-forge -c bioconda \
    'skani>=0.4.0' 'fastani>=1.3' pixi

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:/opt/conda/envs/galah_deps/bin:$PATH

RUN cargo install galah --version GALAH_VERSION --locked

WORKDIR /app
RUN git clone --depth 1 --branch vGALAH_VERSION https://github.com/wwood/galah galah_src

RUN galah --version
RUN galah cluster \
    --genome-fasta-files galah_src/tests/data/set1/1mbp.fna galah_src/tests/data/set1/500kb.fna \
    --output-cluster-definition test_cargo_clusters.tsv
RUN cat test_cargo_clusters.tsv

COPY test_quality.sh /app/test_quality.sh
ENV GALAH_CMD="galah" PIXI_CMD="pixi"
